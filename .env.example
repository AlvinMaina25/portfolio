# Copy this file to ".env.local" and fill in your own values. Never commit .env.local.
# Vite only exposes variables that start with VITE_ to the browser, so treat every
# value here as PUBLIC (a Formspree URL or WhatsApp number is fine; API secrets are not).

# Formspree form endpoint, e.g. https://formspree.io/f/xxxxxxxx
# The address that RECEIVES form messages is set in the Formspree dashboard (the form's
# notification/destination email, alvinmaina2505@gmail.com), NOT here.
VITE_FORMSPREE_ENDPOINT=

# WhatsApp number, digits only, country code first, no "+"
VITE_WHATSAPP_NUMBER=

# Public contact email shown in the Contact section and the social icons.
# Leave empty to hide every email link (nothing placeholder is ever shown).
VITE_CONTACT_EMAIL=alvinmaina2505@gmail.com

# Production: set these three in your hosting provider's environment-variable settings (or in a
# local .env.production.local) BEFORE running `npm run build`. Vite writes them into the built
# files at build time, so changing a value later means building and deploying again.
# See DEPLOYMENT.md.
